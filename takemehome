#!/usr/bin/env bash

set -e

ZINIT_HOME="${HOME}/.zinit/bin"
ZSHRC="${HOME}/.zshrc"
TMUX_CONF="${HOME}/.tmux.conf"
TPM_DIR="${HOME}/.tmux/plugins/tpm"

# Detect OS
case "$OSTYPE" in
    linux*)  OS="linux" ;;
    darwin*) OS="macos" ;;
    *) echo "Unsupported OS: $OSTYPE"; exit 1 ;;
esac

echo "Detected OS: $OS"

# Install zinit
if [[ ! -d "$ZINIT_HOME" ]]; then
   echo "Installing zinit..."
   mkdir -p "$(dirname "$ZINIT_HOME")"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
else
   echo "zinit already installed."
fi

# Define zinit plugin block
ZINIT_BLOCK=$(cat <<'EOF'

# --- Zinit Setup ---
#
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZINIT_HOME="${HOME}/.zinit/bin"
source "${ZINIT_HOME}/zinit.zsh"

# Plugins
zinit load romkatv/powerlevel10k
zinit load zdharma-continuum/fast-syntax-highlighting
zinit load zsh-users/zsh-autosuggestions
zinit load zsh-users/zsh-completions
zinit load zdharma/fast-syntax-highlighting

# Powerlevel10k config
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# --- Shared, real-time zsh history ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt SHARE_HISTORY         # Share history between all sessions
setopt INC_APPEND_HISTORY    # Append commands to the history file immediately
setopt HIST_IGNORE_ALL_DUPS  # Avoid repeated entries
setopt HIST_REDUCE_BLANKS    # Strip unnecessary spaces
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_VERIFY

EOF
)

# -----------------------
# Install tmux
# -----------------------
install_tmux() {
  echo "Installing tmux..."

  if command -v tmux >/dev/null 2>&1; then
    echo "tmux already installed."
    return
  fi

  if [[ "$OS" == "macos" ]]; then
    if ! command -v brew >/dev/null; then
      echo "Homebrew not found. Installing Homebrew..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    brew install tmux
  elif [[ "$OS" == "linux" ]]; then
    if command -v apt >/dev/null; then
      sudo apt update && sudo apt install -y tmux
    elif command -v dnf >/dev/null; then
      sudo dnf install -y tmux
    elif command -v pacman >/dev/null; then
      sudo pacman -Sy tmux --noconfirm
    else
      echo "No supported package manager found. Install tmux manually."
    fi
  fi
}
install_tmux

# -----------------------
# Install TPM (Tmux Plugin Manager)
# -----------------------
if [[ ! -d "$TPM_DIR" ]]; then
  echo "Installing tmux plugin manager (TPM)..."
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
else
  echo "TPM already installed."
fi

# -----------------------
# Write ~/.tmux.conf
# -----------------------
if ! grep -q "tmux-plugins/tpm" "$TMUX_CONF" 2>/dev/null; then
  echo "Writing tmux config with TPM and vim navigator plugin..."
  cat <<EOF > "$TMUX_CONF"
# Enable mouse and vi mode
set -g mouse on
setw -g mode-keys vi
set -g history-limit 10000

# Tmux prefix and reload
bind '\\' split-window -h
bind '-' split-window -v
unbind C-b
set -g prefix C-Space
bind r source-file ~/.tmux.conf \; display-message "Config reloaded"

# TPM plugin section
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'catppuccin/tmux'

# --- Catppuccin Theme Settings ---
set -g @catppuccin_flavour 'mocha'  # Options: latte, frappe, macchiato, mocha


# TPM run
run '~/.tmux/plugins/tpm/tpm'

EOF
else
  echo ".tmux.conf already configured. Skipping rewrite."
fi

echo "Reloading tmux config..."
tmux source-file "$TMUX_CONF" || echo "No tmux server running; skip config reload."-----------------------

# Install tmux plugins via TPM
# -----------------------
echo "Installing tmux plugins via TPM..."
tmux new-session -d -s temp_tpm_session && \
  sleep 1 && \
  tmux send-keys -t temp_tpm_session 'run-shell ~/.tmux/plugins/tpm/scripts/install_plugins.sh' C-m && \
  sleep 2 && \
  tmux kill-session -t temp_tpm_session

# -----------------------
# Install NVIM
# -----------------------
# --- Variables ---
NVIM_URL="https://raw.githubusercontent.com/MaxEJohnson/takemehome/main/nvim.zip"
NVIM_PATH="${HOME}/.config/nvim.zip"

# --- Download your nvim configs ---
echo "Downloading nvim.zip from your repo..."
curl -fsSL "$NVIM_URL" -o "$NVIM_PATH"

cd ~/.config/ 
unzip nvim.zip
rm nvim.zip

# Add zinit block if it's not already in .zshrc
if ! grep -q "zinit load romkatv/powerlevel10k" "$ZSHRC" 2>/dev/null; then
 echo "Adding zinit config to .zshrc..."
   echo "$ZINIT_BLOCK" >> "$ZSHRC"
else
     echo ".zshrc already has zinit config. Skipping append."
fi


# Warn if zsh is not the default shell
if [[ "$SHELL" != *zsh ]]; then
    echo -e "${YLW}Your current shell is not Zsh: $SHELL${WHT}"
    echo "To change it, run: chsh -s $(command -v zsh)"
fi

# Reload shell and run p10k configure
echo "Reloading shell and launching Powerlevel10k config..."
exec zsh -i -c 'source ~/.zshrc; p10k configure'

# check if ssh key is present for github
if [ ! -f ~/.ssh/id_ed25519.pub ]; then
    echo -e "${WHT}ssh keys not detected => ${YLW}installing" 
    read -p "Enter email for github: " gitemail
    ssh-keygen -t ed25519 -C $gitemail
else
    echo -e "${GRN}ssh keys exist"
fi
